# ==========================================
# Hirbit Store - Root Environment Configuration
# ==========================================

# Backend Configuration (backend/.env)
PORT=3000
NODE_ENV=development

# Store Branding & Currency Localization
STORE_NAME="Hirbit Store"
STORE_ADDRESS="Hawassa Piyassa Mall, 1st Floor (Near Kibiru Hospital), Hawassa"
STORE_CITY="Hawassa, Ethiopia"
DEFAULT_CURRENCY=ETB

# Database Configuration
# Neon PostgreSQL connection string (Serverless pooler with SSL):
DATABASE_URL="postgresql://neondb_owner:[password]@[endpoint]-pooler.[region].aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Authentication
JWT_SECRET=hirbit-store-secure-secret-key-2026-production
JWT_EXPIRES_IN_SECONDS=604800
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# AI & Demo Services
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"

# Frontend Configuration (frontend/.env)
VITE_API_BASE_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000
VITE_APP_TITLE="Hirbit Store - Inventory & POS Management"
