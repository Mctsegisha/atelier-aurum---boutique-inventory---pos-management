# Hirbit Store - Backend Environment Configuration
PORT=3000
NODE_ENV=development

# Store Metadata & Currency
STORE_NAME="Hirbit Store"
STORE_ADDRESS="Hawassa Piyassa Mall, 1st Floor (Near Kibiru Hospital), Hawassa"
STORE_CITY="Hawassa, Ethiopia"
DEFAULT_CURRENCY=ETB

# Database Configuration (Neon PostgreSQL via Serverless Pooler with SSL)
DATABASE_URL="postgresql://neondb_owner:[password]@[endpoint]-pooler.[region].aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# JWT Authentication Secret (Minimum 16 characters)
JWT_SECRET=hirbit-store-secure-secret-key-2026-production
JWT_EXPIRES_IN_SECONDS=604800

# CORS Configuration (Comma-separated origins or * for open development)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Demo Access Controls
DEMO_MODE=true
DEMO_SECRET_KEY=hirbit-demo-access-key-2026

# Gemini AI API Key (for catalog generation & style assistance)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
